# Server-only mail configuration. Never prefix these with NEXT_PUBLIC_.
# Do not put a real mailbox password in this file.

SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
# Established name (Greece / existing deploys)
SMTP_PASS=
# Alias accepted by the app (same value as SMTP_PASS)
SMTP_PASSWORD=

MAIL_FROM_EMAIL=
MAIL_FROM_NAME=
MAIL_REPLY_TO=

# Internal notification recipient (contact form, admin CC). Separate from From.
MAIL_INTERNAL_TO=
# Optional extra transfer-admin recipient
MAIL_FROM_TO_ADMIN=
# Optional official-confirmation CC override
ORDER_CONFIRMATION_CC_EMAIL=

# ─── Email testing (QA / local) ───────────────────────────────
# When EMAIL_TESTING=true:
#   - SMTP never goes to the original customer/partner/admin recipients
#   - If EMAIL_TEST_ADDRESS is set, mail is redirected only to that sink
#   - If EMAIL_TEST_ADDRESS is unset, SMTP is skipped; MailLog status=skipped
#   - Telegram is not sent (opt in with EMAIL_TESTING_ALLOW_TELEGRAM=true)
# Production must leave EMAIL_TESTING unset/false.
# EMAIL_TESTING=true
# EMAIL_TEST_ADDRESS=qa-sink@example.com
# EMAIL_TESTING_ALLOW_TELEGRAM=false

# Spain / Rovaro example (use on the ES deployment only):
# SMTP_HOST=mail.site.eu
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=admin@rovaro.autos
# SMTP_PASS=
# SMTP_PASSWORD=
# MAIL_FROM_EMAIL=admin@rovaro.autos
# MAIL_FROM_NAME=Rovaro
# MAIL_REPLY_TO=admin@rovaro.autos
# MAIL_INTERNAL_TO=admin@rovaro.autos

# ─── Stripe (test + live) ─────────────────────────────────────
# Mode: test | live (default test). Keep both key sets; switch with STRIPE_MODE.
STRIPE_MODE=test
STRIPE_SECRET_KEY_TEST=
STRIPE_PUBLISHABLE_KEY_TEST=
STRIPE_WEBHOOK_SECRET_TEST=
STRIPE_SECRET_KEY_LIVE=
STRIPE_PUBLISHABLE_KEY_LIVE=
STRIPE_WEBHOOK_SECRET_LIVE=
# Webhook: POST /api/payments/stripe/webhook
# Events: checkout.session.completed, checkout.session.async_payment_succeeded,
# checkout.session.expired, checkout.session.async_payment_failed,
# charge.refunded, charge.dispute.created/updated/closed
#
# Expired marketplace holds: POST /api/internal/booking-holds/cleanup
# Expired alternative offers: POST /api/internal/alternative-offers/expire
# Retry failed Checkout invalidations:
#   POST /api/internal/marketplace-checkout-invalidation/retry
# All use Authorization: Bearer $CRON_SECRET (POST only; GET does not mutate).
# See docs/booking-hold-indexes.md, docs/alternative-offer-expiration.md,
# and docs/marketplace-checkout-invalidation.md.

# ─── Legal operator (Rovaro) ──────────────────────────────────
# Rovaro operator / platform legal data
# --------------------------------------
# Rovaro is the product brand. NK Platform Studio is only the trading name of
# the sole-trader operator. These LEGAL_* values feed config/legalEntity.js and
# Platform settings → My business details (DB overrides still win when saved).
#
# Leave a value EMPTY until it is officially confirmed. Placeholders like
# "your full Irish business address" are treated as unset and never published.

LEGAL_TRADING_NAME=NK Platform Studio
LEGAL_BRAND_NAME=Rovaro
LEGAL_BUSINESS_TYPE=SOLE_TRADER
LEGAL_BUSINESS_ADDRESS=
LEGAL_COUNTRY=Ireland
LEGAL_COUNTRY_CODE=IE
LEGAL_EMAIL=admin@rovaro.autos
LEGAL_SUPPORT_EMAIL=admin@rovaro.autos
LEGAL_DOMAINS=rovaro.es,rovaro.autos
LEGAL_GOVERNING_LAW=Ireland
LEGAL_CURRENCY=EUR

# Public mirror for footer / client-rendered legal pages (optional duplicate)
NEXT_PUBLIC_LEGAL_BUSINESS_ADDRESS=
NEXT_PUBLIC_LEGAL_BUSINESS_NAME_NUMBER=
# EU | IE | UA — jurisdiction tag for the external legal-doc API (default IE)
NEXT_PUBLIC_LEGAL_JUR=IE

# Server only — never prefix with NEXT_PUBLIC_, never rendered publicly
LEGAL_VAT_NUMBER=
LEGAL_TAX_REFERENCE_NUMBER=
LEGAL_VAT_REGISTERED=false
# manual | clickwrap | external_esign (default clickwrap)
LEGAL_ESIGN_PROVIDER=clickwrap

# Signing key for one-time partner booking-confirmation links.
# Falls back to EMAIL_ACTION_SECRET then NEXTAUTH_SECRET; there is NO weak
# default — links cannot be issued at all if none of these is set.
BOOKING_CONFIRM_SECRET=

# Signing key for opaque driving-licence upload receipts (public intake →
# order create). Prefer a dedicated value. Falls back through
# BOOKING_CONFIRM_SECRET → EMAIL_ACTION_SECRET → NEXTAUTH_SECRET →
# AUTH_SECRET → CLOUDINARY_API_SECRET (or the secret inside CLOUDINARY_URL).
# Without any of these (≥16 chars), licence photo upload returns
# "upload did not complete" and booking cannot proceed.
DRIVING_LICENCE_RECEIPT_SECRET=

# ─── Driving licence retention job ────────────────────────────
# Daily erasure of customer driving licence images, scheduled in vercel.json
# (GET /api/admin/legal/driving-licence-retention).
#
# Vercel Cron sends `Authorization: Bearer $CRON_SECRET` automatically once
# CRON_SECRET is set on the project, so that alone is enough. Set
# DOCUMENT_RETENTION_CRON_SECRET only to give this job its own rotatable key.
# With neither set the endpoint is superadmin-only — there is NO weak default.
CRON_SECRET=
# DOCUMENT_RETENTION_CRON_SECRET=
#
# Retention length (days) and page size are NOT env vars: they live in
# PlatformSettings.legal (documentRetentionDays, documentRetentionBatchSize,
# documentRetentionMaxBatches) and are edited in the superadmin Legal
# Configuration panel.

# Rate limits for the new legal endpoints (optional overrides)
# BOOKING_CONFIRM_RATE_LIMIT_MAX=20
# AGREEMENT_ACCEPT_RATE_LIMIT_MAX=5
# ALTERNATIVE_DECISION_RATE_LIMIT_MAX=20
# RETENTION_JOB_RATE_LIMIT_MAX=10

# ─── Google Maps / Places (server only) ───────────────────────
# Used by /api/public/places/autocomplete, /api/public/places/resolve,
# and Distance Matrix (transfer / delivery quotes).
#
# Adding your website domain under "HTTP referrers" does NOT enable
# address search. This app calls Places from the Next.js server
# (empty Referer). Browser keys restricted by HTTP referrer return
# REQUEST_DENIED ("API keys with referer restrictions cannot be used
# with this API" / "Requests from referer <empty> are blocked").
#
# In Google Cloud → APIs & Services → Credentials → this key:
#   Application restrictions: None, or IP addresses (server / Vercel
#     egress). Never "HTTP referrers (web sites)".
#   API restrictions: Places API (New) and/or Places API
#     (plus Distance Matrix API if you use transfer quotes).
# Enable billing on the project. Never prefix with NEXT_PUBLIC_.
# Never put a real key in this file.
GOOGLE_MAPS_API_KEY=
# Optional timeout for Places HTTP calls (ms, default 8000)
# GOOGLE_PLACES_TIMEOUT_MS=8000
# Public Places autocomplete rate limit (optional overrides)
# PLACES_AUTOCOMPLETE_RATE_LIMIT_MAX=30
# PLACES_AUTOCOMPLETE_RATE_LIMIT_WINDOW_SEC=60

# Cloud Translation API v2 — company rental rules (English source → all
# site languages) shown in the booking contract modal. If unset, the
# Maps key is reused when Cloud Translation API is enabled on that
# GCP project. Server key only; never NEXT_PUBLIC_.
# GOOGLE_TRANSLATE_API_KEY=

# ─── MongoDB ──────────────────────────────────────────────────
# MONGODB_URI=mongodb+srv://…  (production / Atlas; never commit credentials)
# Opt-in IPv4 preference for sandboxes where SRV over IPv6 fails.
# Leave unset in production — Atlas dual-stack is normal.
# MONGODB_FORCE_IPV4=true

# Build into a separate directory so `next build` can run beside `next dev`
# NEXT_DIST_DIR=.next-build
