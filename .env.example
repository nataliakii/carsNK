# Server-only mail configuration. Never prefix these with NEXT_PUBLIC_.
# Do not put a real mailbox password in this file.

SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
# Established name (Greece / existing deploys)
SMTP_PASS=
# Alias accepted by the app (same value as SMTP_PASS)
SMTP_PASSWORD=

MAIL_FROM_EMAIL=
MAIL_FROM_NAME=
MAIL_REPLY_TO=

# Internal notification recipient (contact form, admin CC). Separate from From.
MAIL_INTERNAL_TO=
# Optional extra transfer-admin recipient
MAIL_FROM_TO_ADMIN=
# Optional official-confirmation CC override
ORDER_CONFIRMATION_CC_EMAIL=

# Spain / Rovaro example (use on the ES deployment only):
# SMTP_HOST=mail.site.eu
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=admin@rovaro.autos
# SMTP_PASS=
# SMTP_PASSWORD=
# MAIL_FROM_EMAIL=admin@rovaro.autos
# MAIL_FROM_NAME=Rovaro
# MAIL_REPLY_TO=admin@rovaro.autos
# MAIL_INTERNAL_TO=admin@rovaro.autos

# ─── Stripe (test + live) ─────────────────────────────────────
# Mode: test | live (default test). Keep both key sets; switch with STRIPE_MODE.
STRIPE_MODE=test
STRIPE_SECRET_KEY_TEST=
STRIPE_PUBLISHABLE_KEY_TEST=
STRIPE_WEBHOOK_SECRET_TEST=
STRIPE_SECRET_KEY_LIVE=
STRIPE_PUBLISHABLE_KEY_LIVE=
STRIPE_WEBHOOK_SECRET_LIVE=
# Webhook: POST /api/payments/stripe/webhook
# Events: checkout.session.completed, checkout.session.async_payment_succeeded
