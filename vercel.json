{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/admin/legal/driving-licence-retention",
      "schedule": "17 3 * * *"
    },
    {
      "path": "/api/internal/close-completed-rentals",
      "schedule": "5 * * * *"
    }
  ]
}
